{
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "prettier.configPath": "kubejs/.prettierrc",
    "json.schemas": [
        {
            "fileMatch": [
                "/lang/*.json"
            ],
            "url": "./.vscode/probe.lang-schema.json"
        },
        {
            "fileMatch": [
                "/probe/docs/*.json"
            ],
            "url": "./.vscode/probe.doc-schema.json"
        }
    ]
}